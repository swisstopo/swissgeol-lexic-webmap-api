{
  "name": "webmap-api-mock",
  "version": "1.0.0",
  "private": true,
  "description": "Mock server for SwissTopo WebMap Filter API (v1.2.0)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npx tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "smoke": "python3 scripts/smoke_test.py",
    "smoke:docs": "python3 scripts/swagger_docs_test.py"
  },
  "dependencies": {
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^2.1.0",
    "fastify": "^4.26.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "openapi-types": "^12.1.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
