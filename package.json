{
  "name": "webmap-api-mock",
  "version": "0.0.8-dev-spec1.6.2",
  "private": true,
  "description": "Server for SwissTopo WebMap Filter API (v1.6.2)",
  "main": "dist/index.js",
  "scripts": {
    "generate:types": "ts-node scripts/generate_openapi_types.ts",
    "dev": "npm run generate:types && ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npm run generate:types && npx tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "smoke": "python3 test/http_smoke_test.py",
    "smoke:docs": "npx ts-node test/swagger_docs_smoke_test.ts",
    "smoke:graphdb": "npx ts-node test/graphdb/graphdb_smoke_test.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "graphdb": "^4.0.0",
    "js-yaml": "^5.5.0",
    "openapi-request-validator": "^12.1.3",
    "openapi-response-validator": "^12.1.3",
    "sparqlxml-parse": "3.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "openapi-types": "^12.1.3",
    "openapi-typescript": "^7.13.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
