# Port for the Fastify server
PORT=3000

# Logging level for Fastify (e.g., info, debug)
LOG_LEVEL=info

# GeoServer base URL used by `/layers/{layerId}/attributeList` and `/wms`
GEOSERVER_BASE_URL=

# Optional GeoServer request timeout in milliseconds. Defaults to 30000.
GEOSERVER_REQUEST_TIMEOUT_MS=

# GraphDB base URL used by the internal connectivity smoke test
GRAPHDB_BASE_URL=

# GraphDB basic auth username
GRAPHDB_USERNAME=

# GraphDB basic auth password
GRAPHDB_PASSWORD=

# Prefix URL injected into the SPARQL query templates
VOCABULARY_PREFIX_URL=

# GraphDB repository id for the Chronostratigraphy vocabulary
CHRONOSTRATIGRAPHY_REPO_ID=

# GraphDB repository id for the Tectonic Units vocabulary
TECTONICUNITS_REPO_ID=

# GraphDB repository id for the Lithostratigraphy vocabulary
LITHOSTRATIGRAPHY_REPO_ID=

# GraphDB repository id for the Lithology vocabulary
LITHOLOGY_REPO_ID=

# Base URL for smoke test script (server must already be running)
BASE_URL=http://localhost:3000/v1
